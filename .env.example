# Variables que usa Docker Compose para resolver docker-compose.yml / compose.deploy.yml.
# NO llegan a los contenedores: la configuración de cada backend está en env/<DEPLOY_ENV>/*.env
#
# Compose lee automáticamente el archivo .env de este directorio: cp .env.example .env
# En la computadora de desarrollo es opcional (todo tiene valor por defecto salvo las imágenes,
# que solo usa compose.deploy.yml). En cada servidor define el ambiente y las imágenes.

# Ambiente: dev | staging | prod -> selecciona env/<DEPLOY_ENV>/backend-a.env y backend-b.env
DEPLOY_ENV=staging

# Imágenes versionadas (solo compose.deploy.yml). Nombre completo con tag, nunca "latest".
# El workflow de release publica en Docker Hub con el tag de Git, que incluye la "v".
# compose.deploy.yml necesita imágenes con HEALTHCHECK (publicadas después de v2.0.0);
# v1.0.0 aquí solo ilustra el formato.
BACKEND_A_IMAGE=jorgeriveracoder/backend-a:v1.0.0
BACKEND_B_IMAGE=jorgeriveracoder/backend-b:v1.0.0

# Puertos publicados en el host (lado izquierdo de "ports:"). Por defecto 8000 y 8080.
# Cámbialos solo si ejecutas varios ambientes en la misma máquina.
#BACKEND_A_HOST_PORT=8000
#BACKEND_B_HOST_PORT=8080

# Nombre del proyecto de Compose (prefijo de contenedores y red). Por defecto, el nombre
# del directorio. Necesario distinto por ambiente si comparten máquina.
#COMPOSE_PROJECT_NAME=demo-staging
