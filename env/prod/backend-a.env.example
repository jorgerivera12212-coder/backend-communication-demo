# Configuración del contenedor backend-a en el ambiente "prod" (Compose la inyecta con env_file).
# Copiar sin .example: cp env/prod/backend-a.env.example env/prod/backend-a.env
APP_NAME=backend-a
APP_ENV=prod
LOG_LEVEL=INFO
# Puerto interno del contenedor: debe coincidir con el lado derecho de "ports:" en Compose
SERVER_PORT=8000
# Dentro de Docker, backend-b se resuelve por nombre de servicio (no localhost)
BACKEND_B_URL=http://backend-b:8080
BACKEND_B_TIMEOUT=5.0
