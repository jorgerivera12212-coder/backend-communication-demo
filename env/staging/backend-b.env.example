# Configuración del contenedor backend-b en el ambiente "staging" (Compose la inyecta con env_file).
# Copiar sin .example: cp env/staging/backend-b.env.example env/staging/backend-b.env
APP_NAME=backend-b
APP_ENV=staging
SERVER_ADDRESS=0.0.0.0
# Puerto interno del contenedor: debe coincidir con el lado derecho de "ports:" en Compose
SERVER_PORT=8080
LOG_LEVEL=INFO
# Dentro de Docker, backend-a se resuelve por nombre de servicio (no localhost)
BACKEND_A_URL=http://backend-a:8000
BACKEND_A_TIMEOUT=5.0
