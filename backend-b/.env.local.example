# Solo para ejecutar desde el IDE / terminal (sin Docker): cp .env.local.example .env.local
# En Docker estas variables llegan desde env/<DEPLOY_ENV>/backend-b.env
APP_NAME=backend-b
APP_ENV=dev
SERVER_ADDRESS=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=INFO
BACKEND_A_URL=http://localhost:8000
BACKEND_A_TIMEOUT=5.0
